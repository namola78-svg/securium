{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "dev:cloudflare": "node scripts/run-vinext.mjs dev",
    "build:cloudflare": "node scripts/run-vinext.mjs build",
    "start:cloudflare": "node scripts/run-vinext.mjs start",
    "admin:bootstrap": "node scripts/admin-bootstrap.mjs --local --config wrangler.local.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/domain.test.ts tests/phase3-domain.test.ts tests/specialized-domain.test.ts tests/ai-domain.test.ts tests/audio-domain.test.ts tests/lecture-domain.test.ts tests/content-revision-domain.test.ts tests/audit-domain.test.ts tests/security-domain.test.ts tests/auth-provider.test.ts tests/supabase-preparation.test.ts tests/postgres-runtime.test.ts tests/repository-contract.test.ts tests/curriculum-domain.test.ts tests/shared-content-domain.test.ts tests/course-lesson-progress-domain.test.ts tests/course-lesson-bridge-migration.test.ts tests/shared-content-seed.test.ts tests/security-certification-curriculum-domain.test.ts tests/security-certification-curriculum-seed.test.ts tests/learn-overview-domain.test.ts",
    "test:integration": "node scripts/run-d1-test-suite.mjs --test --test-concurrency=1 tests/rendered-html.test.mjs",
    "test:e2e": "npm run build && node scripts/run-d1-test-suite.mjs --test --test-concurrency=1 tests/rendered-html.test.mjs tests/phase3-e2e.test.mjs tests/specialized-e2e.test.mjs tests/practical-e2e.test.mjs tests/ai-e2e.test.mjs tests/ai-specialized-e2e.test.mjs tests/audio-e2e.test.mjs tests/lecture-e2e.test.mjs tests/content-revision-e2e.test.mjs tests/audit-e2e.test.mjs tests/curriculum-e2e.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "node scripts/run-drizzle-kit.mjs generate",
    "db:check": "node scripts/run-drizzle-kit.mjs check --config=drizzle.config.ts",
    "db:migrate": "node scripts/run-wrangler.mjs d1 migrations apply DB --local --config wrangler.local.jsonc",
    "db:seed": "node scripts/run-wrangler.mjs d1 execute DB --local --config wrangler.local.jsonc --file db/seed.sql",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:postgres:generate": "node scripts/generate-postgres-schema.mjs",
    "db:postgres:validate": "node scripts/postgres-migrations.mjs validate",
    "db:postgres:status": "node scripts/postgres-migrations.mjs status",
    "db:postgres:runtime-status": "node scripts/postgres-runtime-status.mjs",
    "db:postgres:deploy": "node scripts/postgres-migrations.mjs deploy",
    "db:postgres:schema:curriculum": "node scripts/apply-curriculum-schema.mjs",
    "db:postgres:schema:shared-content": "node scripts/apply-shared-content-schema.mjs",
    "db:postgres:seed:shared-content": "node scripts/apply-shared-content-seed.mjs",
    "curriculum:security-certification:sql": "node scripts/generate-security-certification-curriculum-seed.mjs --all --write",
    "curriculum:security-certification:seed:d1-local": "node scripts/apply-security-certification-curriculum-seed.mjs d1-local",
    "curriculum:security-certification:seed:postgres": "node scripts/apply-security-certification-curriculum-seed.mjs postgres",
    "curriculum:security-certification:verify:d1-local": "node scripts/verify-security-certification-curriculum-seed.mjs d1-local",
    "curriculum:security-certification:verify:postgres": "node scripts/verify-security-certification-curriculum-seed.mjs postgres",
    "curriculum:security-certification:coverage:d1-local": "node scripts/verify-security-certification-curriculum-coverage.mjs d1-local",
    "curriculum:security-certification:coverage:postgres": "node scripts/verify-security-certification-curriculum-coverage.mjs postgres",
    "curriculum:security-certification:activate:postgres": "node scripts/activate-security-certification-curriculum.mjs",
    "db:postgres:security:generate": "node scripts/generate-postgres-rls.mjs",
    "db:postgres:security:validate": "node scripts/generate-postgres-rls.mjs --check",
    "migration:d1:export": "node scripts/d1-postgres-migration.mjs export-d1",
    "migration:postgres:import": "node scripts/d1-postgres-migration.mjs import-postgres",
    "migration:verify": "node scripts/d1-postgres-migration.mjs verify-migration"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.9",
    "drizzle-orm": "0.45.2",
    "next": "16.2.12",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.47.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitejs/plugin-rsc": "0.5.31",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "0.2.1",
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  },
  "type": "module"
}
