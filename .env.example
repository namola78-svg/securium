# Development-only local identity used by the retained Sites/Cloudflare path.
# These sample values are not secrets and should not be used as passwords.
DEV_AUTH_EMAIL=dev-super-admin@example.invalid
APP_ENV=development

# Public site URL used for metadata, Open Graph, and canonical image URLs.
# Example: https://securium.vercel.app
NEXT_PUBLIC_SITE_URL=

# Authentication provider
# sites: Sign in with ChatGPT headers in the retained Sites/Cloudflare path.
# supabase: Supabase Auth email/password and OAuth flow for Native Next.js/Vercel.
AUTH_PROVIDER=sites

# Database provider
# DB_PROVIDER is required in Preview/Production and optional in Development.
# Use d1 for the current Cloudflare path or supabase for the PostgreSQL path.
DB_PROVIDER=d1

# Native Next.js/Vercel uses Supabase PostgreSQL. The retained Cloudflare
# rollback path can still select D1 explicitly.
# DATABASE_URL: runtime pooled connection URL. Required only for DB_PROVIDER=supabase.
# DIRECT_URL: migration/direct connection URL. Never put it in the Vercel Build Command.
DATABASE_URL=
DIRECT_URL=

# Serverless PostgreSQL pool tuning. Supabase transaction pooler owns the shared pool.
POSTGRES_MAX_CONNECTIONS=3
POSTGRES_IDLE_TIMEOUT_SECONDS=20
POSTGRES_CONNECT_TIMEOUT_SECONDS=3
POSTGRES_QUERY_TIMEOUT_MS=10000
# disable is Development-only; Production accepts require or verify-full.
POSTGRES_SSL_MODE=require

# Storage provider
# local is Development/test only. supabase is server-authorized remote Storage.
STORAGE_PROVIDER=local
# SUPABASE_URL: credential-free HTTPS project URL for Auth/Storage.
SUPABASE_URL=
# SUPABASE_ANON_KEY: required when AUTH_PROVIDER=supabase.
SUPABASE_ANON_KEY=
# Google OAuth Client ID/Secret are configured in the Supabase Dashboard,
# not in this application env file. Add this callback URL there:
# https://<your-domain>/api/auth/supabase/oauth/callback
# Public aliases are safe for Supabase Auth browser/project identification only.
# Never put service role keys or database passwords in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY: required for Supabase Storage; server-only.
# Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Bucket names. Override only after the Storage plan is approved.
SUPABASE_PUBLIC_BUCKET=public-thumbnails
SUPABASE_PRIVATE_AUDIO_BUCKET=private-audio
SUPABASE_PRIVATE_LECTURE_BUCKET=private-lectures
SUPABASE_COURSE_ASSETS_BUCKET=course-assets
SUPABASE_ADMIN_IMPORTS_BUCKET=admin-imports

# AI provider
# Mock is the safe default. External OpenAI calls run only when AI_PROVIDER=openai
# and OPENAI_API_KEY is configured in the deployment control plane.
AI_PROVIDER=mock
OPENAI_MODEL=gpt-5.6-luna
AI_DAILY_LIMIT=20
AI_TIMEOUT_MS=8000
AI_MAX_RETRIES=1
AI_RETENTION_DAYS=90

# Audio playback allowlist. Comma-separated HTTPS hostnames only.
# Empty means only same-origin relative URLs are allowed.
AUDIO_ALLOWED_HOSTS=

# Optional production-only salt used after IP network-prefix minimization.
# Configure the actual secret in the hosting environment, never in this file.
AUDIT_IP_HASH_SALT=

# CSP allowlists. Comma-separated HTTPS origins only; paths are ignored.
# Default media/frame origins are also centrally configured in code.
SECURITY_ALLOWED_AUDIO_ORIGINS=
SECURITY_ALLOWED_IMAGE_ORIGINS=
SECURITY_ALLOWED_FRAME_ORIGINS=

# Real secrets must not be written to .env.example or committed to the repository.
# OPENAI_API_KEY=

# Do not configure DEV_AUTH_EMAIL in deployed environments.
