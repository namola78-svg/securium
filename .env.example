# 서버 환경이 development일 때만 적용되는 로컬 신원입니다.
# 아래 값은 비밀번호나 비밀키가 아니며 db/seed.sql의 개발용 계정과 일치합니다.
DEV_AUTH_EMAIL=dev-super-admin@example.invalid
APP_ENV=development

# Authentication provider
# sites: Sign in with ChatGPT headers in the retained Sites/Cloudflare path.
# supabase: Supabase Auth email/password and OAuth flow for Native Next.js/Vercel.
AUTH_PROVIDER=sites

# Database provider
# DB_PROVIDER: required in Preview/Production, optional in Development (defaults to d1).
# Server only. Use d1 for the current Cloudflare path or supabase for the prepared PostgreSQL path.
DB_PROVIDER=d1

# Native Next.js/Vercel uses Supabase PostgreSQL. The retained Cloudflare
# rollback path can still select D1 explicitly.
# DATABASE_URL: required only for DB_PROVIDER=supabase in all environments; server-only pooled runtime URL.
# DIRECT_URL: required by migration commands, not by the runtime factory.
DATABASE_URL=
DIRECT_URL=
# Small serverless pool. Supabase transaction pooler owns the shared pool.
POSTGRES_MAX_CONNECTIONS=1
POSTGRES_IDLE_TIMEOUT_SECONDS=20
POSTGRES_CONNECT_TIMEOUT_SECONDS=3
POSTGRES_QUERY_TIMEOUT_MS=10000
# disable is Development-only; Production accepts require or verify-full.
POSTGRES_SSL_MODE=require

# Storage provider
# STORAGE_PROVIDER: optional in Development, required when Storage is activated in Preview/Production.
# local is Development/test only. supabase is server-authorized remote Storage.
STORAGE_PROVIDER=local
# SUPABASE_URL: required for Supabase Storage in Development/Preview/Production; credential-free HTTPS URL.
SUPABASE_URL=
# SUPABASE_ANON_KEY: required when AUTH_PROVIDER=supabase for password and OAuth auth.
SUPABASE_ANON_KEY=
# Google OAuth Client ID/Secret are configured in the Supabase Dashboard,
# not in this application env file. Add this callback URL there:
# https://<your-domain>/api/auth/supabase/oauth/callback
# Public aliases are safe for Supabase Auth browser/project identification only.
# Never put service role keys or database passwords in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY: required for Supabase Storage; server-only in every environment.
# Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Bucket names: required when non-default names are approved; server configuration, not secrets.
SUPABASE_PUBLIC_BUCKET=public-thumbnails
SUPABASE_PRIVATE_AUDIO_BUCKET=private-audio
SUPABASE_PRIVATE_LECTURE_BUCKET=private-lectures
SUPABASE_COURSE_ASSETS_BUCKET=course-assets
SUPABASE_ADMIN_IMPORTS_BUCKET=admin-imports

# AI는 기본적으로 Mock Provider를 사용합니다.
# 외부 OpenAI 호출은 AI_PROVIDER=openai와 OPENAI_API_KEY가 모두 있을 때만 수행합니다.
AI_PROVIDER=mock
OPENAI_MODEL=gpt-5.6-luna
AI_DAILY_LIMIT=20
AI_TIMEOUT_MS=8000
AI_MAX_RETRIES=1
AI_RETENTION_DAYS=90

# 쉼표로 구분한 HTTPS 오디오 호스트만 외부 재생을 허용합니다.
# 비워 두면 동일 출처 상대 URL만 허용됩니다.
AUDIO_ALLOWED_HOSTS=

# Optional production-only salt used after IP network-prefix minimization.
# Configure the actual secret in the hosting environment, never in this file.
AUDIT_IP_HASH_SALT=

# CSP에서 허용할 HTTPS Origin 목록입니다. 쉼표로 구분하며 경로는 허용하지 않습니다.
# 강의 기본 Origin(YouTube nocookie, Vimeo)은 코드의 중앙 공급자 정책과 일치합니다.
SECURITY_ALLOWED_AUDIO_ORIGINS=
SECURITY_ALLOWED_IMAGE_ORIGINS=
SECURITY_ALLOWED_FRAME_ORIGINS=

# 실제 키는 .env.example이나 저장소에 기록하지 않습니다.
# OPENAI_API_KEY=

# 배포 환경에서는 DEV_AUTH_EMAIL을 설정하지 않습니다.
# 인증은 Sites가 전달하는 SIWC 사용자 헤더를 사용합니다.
