# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/.npm-cache/

# environment files: track names/examples only, never real values
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/work/

# Codex-local working notes and source references
/.codex/
/references/

# local database, generated uploads, and temporary imports
*.sqlite
*.sqlite3
*.db-journal
/uploads/
/public/uploads/
/public/admin-imports/
/storage/
/tmp/
/admin-imports/
*.upload
/wrangler.production.jsonc
/wrangler.*.private.jsonc

# editor and OS-local metadata
.idea/
.vscode/
Thumbs.db
